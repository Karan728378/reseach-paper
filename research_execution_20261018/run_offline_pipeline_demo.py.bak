        "target": "mse-001 (ErgoGlide Mouse checkout)",
        "attrs": DEFAULT_INCLUDE_ATTRIBUTES,
        "action_type": "complete_checkout"
    },
    {
        "demo_id": 5,
        "task_id": "T5",
