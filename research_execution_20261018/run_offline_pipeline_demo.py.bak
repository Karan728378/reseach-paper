}

def verify_source_hashes() -> bool:
    import hashlib
    all_ok = True
    for rel_path, exp_hash in EXPECTED_HASHES.items():
        p = ROOT_DIR / rel_path
        if not p.exists():
            return False
        h = hashlib.sha256(p.read_bytes()).hexdigest()
        if h != exp_hash:
            all_ok = False
    return all_ok

