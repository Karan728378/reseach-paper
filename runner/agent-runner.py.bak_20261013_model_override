# ── Credential Sanitizer (Zero Secret Leakage) ───────────────────────────────
def sanitize_secret_leakage(text: str) -> str:
    """
    Remove any API keys, authorization tokens, or sensitive credentials
    from strings before saving or logging to disk.
    """
    if not isinstance(text, str):
        return text
    # 1. Exact GOOGLE_API_KEY from environment
    api_key = os.environ.get("GOOGLE_API_KEY")
    if api_key and len(api_key) > 5:
        text = text.replace(api_key, "[REDACTED_API_KEY]")
    # 2. Generic Google API key pattern: AIza[0-9A-Za-z-_]{35}
    text = re.sub(r'AIza[0-9A-Za-z\-_]{35}', '[REDACTED_API_KEY]', text)
    # 3. Bearer tokens or authorization headers
    text = re.sub(r'(?i)bearer\s+[a-zA-Z0-9_\-\.]{20,}', 'Bearer [REDACTED_TOKEN]', text)
    # 4. Standard api_key url params
    text = re.sub(r'(?i)(api[_-]?key|key)=([a-zA-Z0-9_\-]{20,})', r'\1=[REDACTED]', text)
    return text


# Patch RunLogger._write to ensure no secrets can be written to raw logs, and log scheduled_run_index
_orig_logger_write = RunLogger._write


def _sanitized_logger_write(self, record):
    if getattr(self, "scheduled_run_index", None) is not None:
        record["scheduled_run_index"] = self.scheduled_run_index
    rec_str = json.dumps(record, ensure_ascii=False)
    clean_str = sanitize_secret_leakage(rec_str)
    self._file.write(clean_str + "\n")
    self._file.flush()


RunLogger._write = _sanitized_logger_write


def append_to_summary_csv(csv_path: Path, run_summary: dict):
    """Append one run's summary to the flat CSV aggregation file, including scheduled_run_index."""
    import csv

    fieldnames = [
        "scheduled_run_index",
        "run_id",
        "phase",
        "repetition_index",
        "variant",
        "task_id",
        "success",
        "partial_score",
        "total_steps",
        "total_time_seconds",
        "order_confirmed",
        "error_message",
        "timestamp_end",
    ]
    write_header = not csv_path.exists()
    with csv_path.open("a", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames, extrasaction="ignore")
        if write_header:
            writer.writeheader()
        writer.writerow(run_summary)


def get_completed_run_indices(csv_paths: list[Path]) -> set[int]:
    """
    Read summary CSV files and return set of scheduled_run_index values
    whose results were valid and successful (success == True).
    Failed runs (success == False) are never treated as completed.
    """
    completed = set()
    for csv_path in csv_paths:
        if not csv_path.exists():
            continue
        try:
            with csv_path.open("r", encoding="utf-8") as f:
                reader = csv.DictReader(f)
                for row in reader:
                    if row.get("success") in ("True", True, "true", "1"):
                        idx = row.get("scheduled_run_index")
                        if idx is not None and str(idx).isdigit():
                            completed.add(int(idx))
        except Exception as e:
            print(f"    WARNING: Failed reading completed runs from {csv_path}: {e}")
    return completed


def extract_fatal_quota_error(history) -> str | None:
    """
    Inspect browser-use agent history for Gemini 429 quota exhaustion.
    Safely checks both AgentHistoryList methods and history items.
    """
    if history is None:
        return None
    if hasattr(history, "errors"):
        try:
            for err in history.errors():
                if err and any(term in str(err) for term in ["429", "RESOURCE_EXHAUSTED", "quota"]):
                    return str(err)
        except Exception:
            pass
    items = getattr(history, "history", history.get("history", []) if isinstance(history, dict) else [])
    for item in items:
        results = getattr(item, "result", item.get("result", []) if isinstance(item, dict) else [])
        for res in results:
            err = getattr(res, "error", res.get("error") if isinstance(res, dict) else None)
            if err and any(term in str(err) for term in ["429", "RESOURCE_EXHAUSTED", "quota"]):
                return str(err)
            if err and "Stopped due to" in str(err):
                return str(err)
    return None

