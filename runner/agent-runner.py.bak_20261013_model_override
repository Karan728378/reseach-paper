def generate_run_schedule(
    variants: list,
    task_ids: list,
    start_rep: int,
    max_reps: int,
    shuffle: bool = True,
    seed: int = 42,
) -> list[dict]:
    """
    Build the complete experiment schedule and optionally shuffle it using a deterministic seed.
    Each item is a dict with repetition_index, variant, task_id, and scheduled_run_index (1-indexed).
    """
    schedule = []
    for rep in range(start_rep, start_rep + max_reps):
        for variant in variants:
            for task_id in task_ids:
                schedule.append({
                    "repetition_index": rep,
                    "variant": variant,
                    "task_id": task_id,
                })
    if shuffle:
        rng = random.Random(seed)
        rng.shuffle(schedule)

    for idx, item in enumerate(schedule, start=1):
        item["scheduled_run_index"] = idx

    return schedule


async def run_experiment(
    phase: str = "exp1_observable",
    max_reps: int = 5,
    start_rep: int = 1,
    dry_run: bool = False,
    variant_filter: list = None,
    task_filter: list = None,
    results_dir: Path = None,
    shuffle: bool = True,
    seed: int = 42,
    resume: bool = False,
    completed_from: Path = None,
    max_runs: int = None,
):
    tasks = load_tasks()
    task_ids = task_filter or ["T1", "T2", "T3", "T4", "T5"]
    variants = variant_filter or VARIANTS

    target_results_dir = results_dir or DEFAULT_RESULTS_DIR
    summary_csv = target_results_dir / f"{phase}-summary.csv"
    
    schedule = generate_run_schedule(
        variants=variants,
        task_ids=task_ids,
        start_rep=start_rep,
        max_reps=max_reps,
        shuffle=shuffle,
        seed=seed,
    )
    total = len(schedule)
    done = 0

    # Identify already completed successful runs
    completed_indices = set()
    if resume:
        csv_sources = []
        if completed_from:
            p = Path(completed_from)
            if p.is_dir():
                csv_sources.append(p / f"{phase}-summary.csv")
            elif p.is_file():
                csv_sources.append(p)
        if summary_csv.exists():
            resolved_csv_sources = [s.resolve() for s in csv_sources if s.exists()]
            if summary_csv.resolve() not in resolved_csv_sources:
                csv_sources.append(summary_csv)
        completed_indices = get_completed_run_indices(csv_sources)

    pending_schedule = [item for item in schedule if item["scheduled_run_index"] not in completed_indices]

    if max_runs is not None:
        if max_runs < 1:
            raise ValueError("--max-runs must be at least 1")
        pending_schedule = pending_schedule[:max_runs]

    if dry_run:
        print(f"\n{'=' * 60}")
        print("  TechMart Experiment -- DRY RUN (Schedule Inspection)")
        print(f"  Phase: {phase.upper()}")
        print(f"  Model: {AGENT_MODEL}")
        print(f"  Provider: {AGENT_PROVIDER}")
        print(f"  {len(variants)} variants x {len(task_ids)} tasks x {max_reps} reps = {total} planned runs")
        print(f"  Order: {'Randomized (seed=' + str(seed) + ')' if shuffle else 'Block Sequential'}")
        print(f"  Target Results Dir: {target_results_dir}")
        if resume:
            print("  Resume Mode: ACTIVE")
            if completed_from:
                print(f"  Completed Source: {completed_from}")
            print(f"  Completed successful runs (skipped): {len(completed_indices)}")
            print(f"  Pending runs to execute:             {len(pending_schedule)}")
        else:
            print(f"  Resume Mode: DISABLED (all {total} runs scheduled)")
        print(f"{'=' * 60}\n")
        if resume:
            from collections import Counter
            print("  Pending Runs Breakdown by Variant:")
            for var, cnt in Counter(item['variant'] for item in pending_schedule).items():
                print(f"    - {var}: {cnt} runs")
            print("\n  Pending Runs Breakdown by Task:")
            for tsk, cnt in Counter(item['task_id'] for item in pending_schedule).items():
                print(f"    - {tsk}: {cnt} runs")
            print("\n  First 5 pending runs:")
            for item in pending_schedule[:5]:
                print(f"    - Run {item['scheduled_run_index']}: Rep {item['repetition_index']}, {item['variant']}, {item['task_id']}")
            print("  Last 5 pending runs:")
            for item in pending_schedule[-5:]:
                print(f"    - Run {item['scheduled_run_index']}: Rep {item['repetition_index']}, {item['variant']}, {item['task_id']}")
        print(f"\n[DRY RUN] Inspection complete. No files created, no API calls made.")
        return

    target_results_dir.mkdir(parents=True, exist_ok=True)
    logger_module.RESULTS_RAW = target_results_dir / "raw"

    print(f"\n{'═' * 60}")
    print("  TechMart Experiment")
    print(f"  Phase: {phase.upper()}")
    print(f"  Model: {AGENT_MODEL}")
    print(f"  Provider: {AGENT_PROVIDER}")
    print(f"  {len(variants)} variants × {len(task_ids)} tasks × {max_reps} reps = {total} runs")
    print(f"  Order: {'Randomized (seed=' + str(seed) + ')' if shuffle else 'Block Sequential'}")
    print(f"  Results: {summary_csv}")
    print("═" * 60)

    for item in schedule:
        rep = item["repetition_index"]
        variant = item["variant"]
        task_id = item["task_id"]
        run_idx = item["scheduled_run_index"]

        if resume and run_idx in completed_indices:
            print(f"  [RESUME] Skipping Run {run_idx}/{total} (Rep {rep}, {variant}, {task_id}) -- already completed successfully")
            continue

        task = tasks[task_id]
        print(f"\n── Scheduled Run {run_idx} of {total} (Rep {rep}, {variant}, {task_id}) ──")
        result = await run_single(
            variant=variant,
            task=task,
            phase=phase,
            rep=rep,
            dry_run=dry_run,
            results_dir=target_results_dir,
            scheduled_run_index=run_idx,
        )
        append_to_summary_csv(summary_csv, result)
        done += 1
        print(f"  Progress: {done}/{total} runs")

        # Fail-fast on quota exhaustion
        if result.get("quota_exhausted"):
            print(f"\n{'!' * 60}")
            print("  [FATAL QUOTA ERROR DETECTED]")
            print(f"  Gemini API quota exhausted at Scheduled Run {run_idx}.")
            print(f"  Error: {result.get('error_message')}")
            print("  Terminating runner immediately to preserve experiment state.")
            print(f"{'!' * 60}\n")
            break

    print(f"\n{'═' * 60}")
    print(f"  ✓ {phase.upper()} COMPLETE")
    print(f"  Runs completed: {done}")
    print(f"  Summary: {summary_csv}")
    print("═" * 60)


