async def run_single(
    variant: str,
    task: dict,
    phase: str,
    rep: int,
    dry_run: bool = False,
    results_dir: Path = None,
    scheduled_run_index: int = None,
) -> dict:
    task_id = task["id"]
    variant_url = f"{BASE_URL}/variants/{variant}/"
    start_hash = task.get("start_hash", "#home")
    start_url = f"{variant_url}{start_hash}"

    target_results_dir = results_dir or RESULTS_DIR
    target_results_dir.mkdir(parents=True, exist_ok=True)
    logger_module.RESULTS_RAW = target_results_dir / "raw"

    logger = RunLogger(variant, task_id, phase, rep)
    logger.scheduled_run_index = scheduled_run_index
    t0 = time.monotonic()

    idx_str = f"  idx={scheduled_run_index}" if scheduled_run_index is not None else ""
    print(f"\n  ▶ run  variant={variant}  task={task_id}  rep={rep}  phase={phase}{idx_str}")
    print(f"    Start URL: {start_url}")

    # ── Dry Run Mode ──────────────────────────────────────────────────────────
    if dry_run:
        print("    [DRY RUN] Skipping agent execution.")
        elapsed = time.monotonic() - t0
        logger.write_header(
            agent_model="DRY_RUN",
            agent_temperature=AGENT_TEMPERATURE,
            static_verification_passed=True,
        )
        logger.write_action("dry_run_placeholder", page_url=start_url)
        logger.write_summary(
            success=False,
            partial_score=0.0,
            total_steps=0,
            total_time_seconds=elapsed,
            error_message="dry_run",
        )
        return {
            "scheduled_run_index": scheduled_run_index,
            "run_id": logger.run_id,
            "variant": variant,
            "task_id": task_id,
            "phase": phase,
            "repetition_index": rep,
            "success": False,
            "partial_score": 0.0,
            "total_steps": 0,
            "total_time_seconds": elapsed,
            "dry_run": True,
            "error_message": "dry_run",
        }

    # ── API Key Check ─────────────────────────────────────────────────────────
    if not os.environ.get("GOOGLE_API_KEY"):
        raise RuntimeError("GOOGLE_API_KEY is not set in this terminal.")

    # ── Browser-use 0.13.10 Imports ───────────────────────────────────────────
    try:
        from browser_use import Agent, BrowserSession
    except ImportError as e:
        raise ImportError(
            "browser-use is not installed in this environment.\n"
            "Run: python -m pip install browser-use"
        ) from e

    llm = make_llm()
    print(f"    Model: {AGENT_MODEL}")
    print(f"    Provider: {AGENT_PROVIDER}")

    browser_session = None

    try:
        logger.write_header(
            agent_model=AGENT_MODEL,
            agent_temperature=AGENT_TEMPERATURE,
            static_verification_passed=True,
        )

        # ── Initialize BrowserSession (0.13.10 API) ───────────────────────────
        browser_session = BrowserSession(
            is_local=True,
            headless=True,
            enable_default_extensions=False,
            keep_alive=True,
            viewport=VIEWPORT,
        )
        await browser_session.start()

        # ── Pre-run Setup (e.g. T5 cart seeding) ──────────────────────────────
        if task.get("setup_script"):
            setup_page = await browser_session.get_current_page()
            if setup_page:
                await setup_page.goto(start_url)
                await run_task_setup(setup_page, task)

        # ── Enable observable serialization & metadata hook ─────────────────
        enable_observable_dom_serialization()

        # ── Create Agent with Initial Navigation Action ───────────────────────
        agent = Agent(
            task=task["instruction"],
            llm=llm,
            browser_session=browser_session,
            initial_actions=[
                {
                    "navigate": {
                        "url": start_url,
                        "new_tab": False,
                    }
                }
            ],
            use_vision=True,
            step_timeout=60,
            include_attributes=OBSERVABLE_ATTRIBUTES,
        )

        # Intercept prepare_step_state to inject live metadata into prompt (prevents browser-use from clearing it)
        orig_prepare_step_state = agent._message_manager.prepare_step_state
        def wrapped_prepare_step_state(*args, **kwargs):
            orig_prepare_step_state(*args, **kwargs)
            pending = getattr(agent, "_pending_step_metadata", None)
            if pending:
                agent._message_manager.state.read_state_description = pending
                agent._pending_step_metadata = None
        agent._message_manager.prepare_step_state = wrapped_prepare_step_state

        orig_create_state_messages = agent._message_manager.create_state_messages
        def wrapped_create_state_messages(*args, **kwargs):
            browser_state_summary = args[0] if len(args) > 0 else kwargs.get("browser_state_summary")
            step_info = args[3] if len(args) > 3 else kwargs.get("step_info")
            url = browser_state_summary.url if browser_state_summary else "unknown"
            step_number = step_info.step_number if step_info else -1

            # 1. Let the original message manager construct the state message (which gets added to context)
            result_val = orig_create_state_messages(*args, **kwargs)
            
            # Read the actually applied metadata
            actual_metadata = agent._message_manager.state.read_state_description
            
            # 2. Capture the EXACT text being supplied to the model context.
            try:
                last_msg = agent._message_manager.get_messages()[-1]
                if hasattr(last_msg, 'content'):
                    if isinstance(last_msg.content, list):
                        parts = []
                        for c in last_msg.content:
                            if hasattr(c, 'text') and isinstance(c.text, str):
                                parts.append(c.text)
                            elif isinstance(c, dict) and 'text' in c:
                                parts.append(c['text'])
                        msg_text = " ".join(parts)
                    else:
                        msg_text = str(last_msg.content)
                else:
                    msg_text = str(last_msg)
            except Exception:
                msg_text = "ERROR_EXTRACTING_PROMPT"

            # 3. Separate the treatment channels
            import re
            
            # Extract read_state content if present
            read_state_match = re.search(r'<read_state>\n(.*?)\n</read_state>', msg_text, re.DOTALL)
            read_state_metadata = read_state_match.group(1).strip() if read_state_match else "EMPTY"
            
            # Extract browser_state content (where DOM ARIA and data-* live)
            browser_state_match = re.search(r'<browser_state>\n(.*?)\n</browser_state>', msg_text, re.DOTALL)
            serialized_dom = browser_state_match.group(1).strip() if browser_state_match else "EMPTY"
            
            # Define summary based on both channels
            metadata_supplied_to_model = {
                "has_read_state": read_state_metadata != "EMPTY",
                "has_dom": serialized_dom != "EMPTY",
                "dom_length": len(serialized_dom) if serialized_dom != "EMPTY" else 0
            }

            audit_record = {
                "scheduled_run_index": getattr(logger, "scheduled_run_index", None),
                "run_id": logger.run_id,
                "variant": variant,
                "task_id": task_id,
                "step_number": step_number,
                "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                "url": url,
                "read_state_metadata": read_state_metadata,
                "serialized_dom": serialized_dom,
                "metadata_supplied_to_model": metadata_supplied_to_model,
                "full_model_prompt": msg_text
            }

            try:
                audit_dir = target_results_dir / "audit-logs"
                audit_dir.mkdir(parents=True, exist_ok=True)
                audit_file = audit_dir / f"{logger.run_id}.jsonl"
                
                clean_record_str = sanitize_secret_leakage(json.dumps(audit_record, ensure_ascii=False))
                
                with open(audit_file, "a", encoding="utf-8") as f:
                    f.write(clean_record_str + "\n")
            except Exception as e:
                print(f"    WARNING: Failed to write audit log: {e}")

            return result_val

        agent._message_manager.create_state_messages = wrapped_create_state_messages

        async def on_step_start_hook(curr_agent):
            try:
                page = await curr_agent.browser_session.get_current_page()
                meta_str = await extract_active_page_metadata(page)
                curr_agent._pending_step_metadata = meta_str
            except Exception:
                curr_agent._pending_step_metadata = None

        print("    Starting browser-use agent...")
        history = await agent.run(max_steps=30, on_step_start=on_step_start_hook)

        # Save browser-use agent history (sanitized for credentials)
        try:
            history_dir = target_results_dir / "agent-history"
            history_dir.mkdir(parents=True, exist_ok=True)
            history_path = history_dir / f"{logger.run_id}.json"
            history.save_to_file(history_path)
            if history_path.exists():
                clean_text = sanitize_secret_leakage(history_path.read_text(encoding="utf-8"))
                history_path.write_text(clean_text, encoding="utf-8")
            print(f"    Agent history saved: {history_path}")
        except Exception as e:
            print(f"    WARNING: Failed to save agent history: {e}")

        elapsed = time.monotonic() - t0

        # Diagnostic only: record browser-use's internal step timing
        try:
            internal_duration = history.total_duration_seconds()
            print(f"    Agent finished in {elapsed:.1f}s")
            print(f"    Browser-use step duration: {internal_duration:.1f}s")
            print(f"    Unaccounted elapsed time: {elapsed - internal_duration:.1f}s")
        except Exception:
            print(f"    Agent finished in {elapsed:.1f}s")

        # ── Post-run Verification ─────────────────────────────────────────────
        try:
            agent_page = await browser_session.get_current_page()
            post = await run_post_verification(agent_page, task_id)
        except Exception as e:
            post = {
                "cart": [],
                "order_confirmed": False,
                "verification": {
                    "success": False,
                    "partial_score": 0.0,
                    "details": {"error": str(e)},
                },
            }

        verification = post["verification"]
        total_steps = len(history) if hasattr(history, "__len__") else 0

        # Detect fatal quota errors swallowed by browser-use
        fatal_quota = extract_fatal_quota_error(history)
        if fatal_quota:
            verification["success"] = False
            summary_err = sanitize_secret_leakage(fatal_quota[:300])
            is_quota_exhausted = True
        else:
            summary_err = None
            is_quota_exhausted = False

        logger.write_summary(
            success=verification["success"],
            partial_score=verification["partial_score"],
            total_steps=total_steps,
            total_time_seconds=elapsed,
            cart_state=post["cart"],
            order_confirmed=post["order_confirmed"],
            error_message=summary_err,
        )

        result = {
            "scheduled_run_index": scheduled_run_index,
            "run_id": logger.run_id,
            "variant": variant,
            "task_id": task_id,
            "phase": phase,
            "repetition_index": rep,
            "success": verification["success"],
            "partial_score": verification["partial_score"],
            "total_steps": total_steps,
            "total_time_seconds": elapsed,
            "order_confirmed": post["order_confirmed"],
            "error_message": summary_err,
            "timestamp_end": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "quota_exhausted": is_quota_exhausted,
        }

    except Exception as e:
        elapsed = time.monotonic() - t0
        err_msg = str(e)
        is_quota = any(term in err_msg for term in ["429", "RESOURCE_EXHAUSTED", "quota"])
        clean_err = sanitize_secret_leakage(err_msg[:300])
        print(f"    ERROR: {clean_err}")
        logger.write_summary(
            success=False,
            partial_score=0.0,
            total_steps=logger._step_counter,
            total_time_seconds=elapsed,
            error_message=clean_err,
        )
        result = {
            "scheduled_run_index": scheduled_run_index,
            "run_id": logger.run_id,
            "variant": variant,
            "task_id": task_id,
            "phase": phase,
            "repetition_index": rep,
            "success": False,
            "partial_score": 0.0,
            "total_steps": 0,
            "total_time_seconds": elapsed,
            "error_message": clean_err,
            "timestamp_end": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "quota_exhausted": is_quota,
        }

    finally:
        # Reliable cleanup: close browser session resources
        if browser_session is not None:
            try:
                await browser_session.stop()
            except Exception:
                pass

    status = "✓" if result.get("success") else "✗"
    print(
        f"    {status} score={result.get('partial_score', 0):.2f}"
        f" steps={result.get('total_steps', 0)}"
        f" time={result.get('total_time_seconds', 0):.1f}s"
    )
    return result


