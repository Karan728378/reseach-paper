# ── Credential Sanitizer (Zero Secret Leakage) ───────────────────────────────
def sanitize_secret_leakage(text: str) -> str:
    """
    Remove any API keys, authorization tokens, or sensitive credentials
    from strings before saving or logging to disk.
    """
    if not isinstance(text, str):
        return text
    # 1. Exact GOOGLE_API_KEY from environment
    api_key = os.environ.get("GOOGLE_API_KEY")
    if api_key and len(api_key) > 5:
        text = text.replace(api_key, "[REDACTED_API_KEY]")
    # 2. Generic Google API key pattern: AIza[0-9A-Za-z-_]{35}
    text = re.sub(r'AIza[0-9A-Za-z\-_]{35}', '[REDACTED_API_KEY]', text)
    # 3. Bearer tokens or authorization headers
    text = re.sub(r'(?i)bearer\s+[a-zA-Z0-9_\-\.]{20,}', 'Bearer [REDACTED_TOKEN]', text)
    # 4. Standard api_key url params
    text = re.sub(r'(?i)(api[_-]?key|key)=([a-zA-Z0-9_\-]{20,})', r'\1=[REDACTED]', text)
    return text


# Patch RunLogger._write to ensure no secrets can be written to raw logs
_orig_logger_write = RunLogger._write


def _sanitized_logger_write(self, record):
    rec_str = json.dumps(record, ensure_ascii=False)
    clean_str = sanitize_secret_leakage(rec_str)
    self._file.write(clean_str + "\n")
    self._file.flush()


RunLogger._write = _sanitized_logger_write

# ══════════════════════════════════════════════════════════════════════════════
# AGENT CONFIGURATION
