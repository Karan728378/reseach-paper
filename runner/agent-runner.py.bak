# ══════════════════════════════════════════════════════════════════════════════
# TASK LOADER
# ══════════════════════════════════════════════════════════════════════════════

def load_tasks() -> dict:
    """Load task definitions from task-definitions.json."""
    if not TASKS_FILE.exists():
        raise FileNotFoundError(f"Task file not found: {TASKS_FILE}")
    data = json.loads(TASKS_FILE.read_text(encoding="utf-8"))
    return {task["id"]: task for task in data["tasks"]}


# ══════════════════════════════════════════════════════════════════════════════
# PRE-RUN SETUP (e.g., T5 cart pre-loading)
# ══════════════════════════════════════════════════════════════════════════════

async def run_task_setup(page, task: dict):
    """
    Execute pre-run setup scripts for tasks that require them (e.g., T5).
    Runs directly inside the browser session page before the agent starts.
    """
    setup = task.get("setup_script")
    if not setup:
        return

    if setup.get("type") == "js_inject":
        print(f"    Running setup script for {task['id']}...")
        code = setup["code"].strip()
        # Browser-use Page.evaluate requires arrow function format: () => { ... }
        if not (code.startswith("(") and "=>" in code):
            code = f"() => {{ {code} }}"
        await page.evaluate(code)
        if setup.get("post_reload"):
            await page.reload()
            await asyncio.sleep(1.0)
        print("    Setup complete.")


# ══════════════════════════════════════════════════════════════════════════════
# POST-RUN VERIFICATION
# ══════════════════════════════════════════════════════════════════════════════

async def run_post_verification(page, task_id: str) -> dict:
    """
    Read window.__cart__ and window.__orderConfirmed__ via browser session page.
    Compares against ground truth using verifier.py functions.
    """
    if page is None:
        return {
            "cart": [],
            "order_confirmed": False,
            "verification": {
                "success": False,
                "partial_score": 0.0,
                "details": {"error": "No active page found in browser session"},
            },
        }

    try:
        # Browser-use Page.evaluate requires arrow function format
        cart_raw = await page.evaluate("() => window.__cart__ || []")
        order_raw = await page.evaluate("() => Boolean(window.__orderConfirmed__)")
        last_order_raw = await page.evaluate("() => window.__lastOrder__ ? window.__lastOrder__.items : []")

        cart = json.loads(cart_raw) if cart_raw else []
        last_order_items = json.loads(last_order_raw) if last_order_raw else []
        
        if isinstance(order_raw, str):
            order_confirmed = order_raw.strip().lower() == "true"
        else:
            order_confirmed = bool(order_raw)

    except Exception as e:
        return {
            "cart": [],
            "order_confirmed": False,
            "verification": {
                "success": False,
                "partial_score": 0.0,
                "details": {"error": f"JS evaluation failed: {e}"},
            },
        }

    if task_id == "T4":
        verification = verify_order_state(order_confirmed, task_id, cart, last_order_items)
    else:
        verification = verify_cart_state(cart, task_id)

    return {
        "cart": cart,
        "order_confirmed": order_confirmed,
        "verification": verification,
    }


# ══════════════════════════════════════════════════════════════════════════════
# SINGLE EXPERIMENTAL RUN
# ══════════════════════════════════════════════════════════════════════════════

async def run_single(
    variant: str,
    task: dict,
    phase: str,
    rep: int,
    dry_run: bool = False,
    results_dir: Path = None,
) -> dict:
    task_id = task["id"]
    variant_url = f"{BASE_URL}/variants/{variant}/"
    start_hash = task.get("start_hash", "#home")
    start_url = f"{variant_url}{start_hash}"

    target_results_dir = results_dir or RESULTS_DIR
    target_results_dir.mkdir(parents=True, exist_ok=True)
    logger_module.RESULTS_RAW = target_results_dir / "raw"

    logger = RunLogger(variant, task_id, phase, rep)
    t0 = time.monotonic()

    print(f"\n  ▶ run  variant={variant}  task={task_id}  rep={rep}  phase={phase}")
    print(f"    Start URL: {start_url}")

    # ── Dry Run Mode ──────────────────────────────────────────────────────────
    if dry_run:
        print("    [DRY RUN] Skipping agent execution.")
        elapsed = time.monotonic() - t0
        logger.write_header(
            agent_model="DRY_RUN",
            agent_temperature=AGENT_TEMPERATURE,
            static_verification_passed=True,
        )
        logger.write_action("dry_run_placeholder", page_url=start_url)
        logger.write_summary(
            success=False,
            partial_score=0.0,
            total_steps=0,
            total_time_seconds=elapsed,
            error_message="dry_run",
        )
        return {
            "run_id": logger.run_id,
            "variant": variant,
            "task_id": task_id,
            "phase": phase,
            "repetition_index": rep,
            "success": False,
            "partial_score": 0.0,
            "total_steps": 0,
            "total_time_seconds": elapsed,
            "dry_run": True,
            "error_message": "dry_run",
        }

    # ── API Key Check ─────────────────────────────────────────────────────────
    if not os.environ.get("GOOGLE_API_KEY"):
        raise RuntimeError("GOOGLE_API_KEY is not set in this terminal.")

    # ── Browser-use 0.13.10 Imports ───────────────────────────────────────────
    try:
        from browser_use import Agent, BrowserSession
    except ImportError as e:
        raise ImportError(
            "browser-use is not installed in this environment.\n"
            "Run: python -m pip install browser-use"
        ) from e

    llm = make_llm()
    print(f"    Model: {AGENT_MODEL}")
    print(f"    Provider: {AGENT_PROVIDER}")

    browser_session = None

    try:
        logger.write_header(
            agent_model=AGENT_MODEL,
            agent_temperature=AGENT_TEMPERATURE,
            static_verification_passed=True,
        )

        # ── Initialize BrowserSession (0.13.10 API) ───────────────────────────
        browser_session = BrowserSession(
            is_local=True,
            headless=True,
            enable_default_extensions=False,
            keep_alive=True,
            viewport=VIEWPORT,
        )
        await browser_session.start()

        # ── Pre-run Setup (e.g. T5 cart seeding) ──────────────────────────────
        if task.get("setup_script"):
            setup_page = await browser_session.get_current_page()
            if setup_page:
                await setup_page.goto(start_url)
                await run_task_setup(setup_page, task)

        # ── Enable observable serialization & metadata hook ─────────────────
        enable_observable_dom_serialization()

        # ── Create Agent with Initial Navigation Action ───────────────────────
        agent = Agent(
            task=task["instruction"],
            llm=llm,
            browser_session=browser_session,
            initial_actions=[
                {
                    "navigate": {
                        "url": start_url,
                        "new_tab": False,
                    }
                }
            ],
            use_vision=True,
            step_timeout=60,
            include_attributes=OBSERVABLE_ATTRIBUTES,
        )

        # Intercept prepare_step_state to inject live metadata into prompt (prevents browser-use from clearing it)
        orig_prepare_step_state = agent._message_manager.prepare_step_state
        def wrapped_prepare_step_state(*args, **kwargs):
            orig_prepare_step_state(*args, **kwargs)
            pending = getattr(agent, "_pending_step_metadata", None)
            if pending:
                agent._message_manager.state.read_state_description = pending
                agent._pending_step_metadata = None
        agent._message_manager.prepare_step_state = wrapped_prepare_step_state

        orig_create_state_messages = agent._message_manager.create_state_messages
        def wrapped_create_state_messages(*args, **kwargs):
            browser_state_summary = args[0] if len(args) > 0 else kwargs.get("browser_state_summary")
            step_info = args[3] if len(args) > 3 else kwargs.get("step_info")
            url = browser_state_summary.url if browser_state_summary else "unknown"
            step_number = step_info.step_number if step_info else -1

            # 1. Let the original message manager construct the state message (which gets added to context)
            result_val = orig_create_state_messages(*args, **kwargs)
            
            # Read the actually applied metadata
            actual_metadata = agent._message_manager.state.read_state_description
            
            # 2. Capture the EXACT text being supplied to the model context.
            try:
                last_msg = agent._message_manager.get_messages()[-1]
                if hasattr(last_msg, 'content'):
                    if isinstance(last_msg.content, list):
                        parts = []
                        for c in last_msg.content:
                            if hasattr(c, 'text') and isinstance(c.text, str):
                                parts.append(c.text)
                            elif isinstance(c, dict) and 'text' in c:
                                parts.append(c['text'])
                        msg_text = " ".join(parts)
                    else:
                        msg_text = str(last_msg.content)
                else:
                    msg_text = str(last_msg)
            except Exception:
                msg_text = "ERROR_EXTRACTING_PROMPT"

            # 3. Separate the treatment channels
            import re
            
            # Extract read_state content if present
            read_state_match = re.search(r'<read_state>\n(.*?)\n</read_state>', msg_text, re.DOTALL)
            read_state_metadata = read_state_match.group(1).strip() if read_state_match else "EMPTY"
            
            # Extract browser_state content (where DOM ARIA and data-* live)
            browser_state_match = re.search(r'<browser_state>\n(.*?)\n</browser_state>', msg_text, re.DOTALL)
            serialized_dom = browser_state_match.group(1).strip() if browser_state_match else "EMPTY"
            
            # Define summary based on both channels
            metadata_supplied_to_model = {
                "has_read_state": read_state_metadata != "EMPTY",
                "has_dom": serialized_dom != "EMPTY",
                "dom_length": len(serialized_dom) if serialized_dom != "EMPTY" else 0
            }

            audit_record = {
                "run_id": logger.run_id,
                "variant": variant,
                "task_id": task_id,
                "step_number": step_number,
                "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                "url": url,
                "read_state_metadata": read_state_metadata,
                "serialized_dom": serialized_dom,
                "metadata_supplied_to_model": metadata_supplied_to_model,
                "full_model_prompt": msg_text
            }

            try:
                audit_dir = target_results_dir / "audit-logs"
                audit_dir.mkdir(parents=True, exist_ok=True)
                audit_file = audit_dir / f"{logger.run_id}.jsonl"
                
                clean_record_str = sanitize_secret_leakage(json.dumps(audit_record, ensure_ascii=False))
                
                with open(audit_file, "a", encoding="utf-8") as f:
                    f.write(clean_record_str + "\n")
            except Exception as e:
                print(f"    WARNING: Failed to write audit log: {e}")

            return result_val

        agent._message_manager.create_state_messages = wrapped_create_state_messages

        async def on_step_start_hook(curr_agent):
            try:
                page = await curr_agent.browser_session.get_current_page()
                meta_str = await extract_active_page_metadata(page)
                curr_agent._pending_step_metadata = meta_str
            except Exception:
                curr_agent._pending_step_metadata = None

        print("    Starting browser-use agent...")
        history = await agent.run(max_steps=30, on_step_start=on_step_start_hook)

        # Save browser-use agent history (sanitized for credentials)
        try:
            history_dir = target_results_dir / "agent-history"
            history_dir.mkdir(parents=True, exist_ok=True)
            history_path = history_dir / f"{logger.run_id}.json"
            history.save_to_file(history_path)
            if history_path.exists():
                clean_text = sanitize_secret_leakage(history_path.read_text(encoding="utf-8"))
                history_path.write_text(clean_text, encoding="utf-8")
            print(f"    Agent history saved: {history_path}")
        except Exception as e:
            print(f"    WARNING: Failed to save agent history: {e}")

        elapsed = time.monotonic() - t0

        # Diagnostic only: record browser-use's internal step timing
        try:
            internal_duration = history.total_duration_seconds()
            print(f"    Agent finished in {elapsed:.1f}s")
            print(f"    Browser-use step duration: {internal_duration:.1f}s")
            print(f"    Unaccounted elapsed time: {elapsed - internal_duration:.1f}s")
        except Exception:
            print(f"    Agent finished in {elapsed:.1f}s")

        # ── Post-run Verification ─────────────────────────────────────────────
        try:
            agent_page = await browser_session.get_current_page()
            post = await run_post_verification(agent_page, task_id)
        except Exception as e:
            post = {
                "cart": [],
                "order_confirmed": False,
                "verification": {
                    "success": False,
                    "partial_score": 0.0,
                    "details": {"error": str(e)},
                },
            }

        verification = post["verification"]
        total_steps = len(history) if hasattr(history, "__len__") else 0

        logger.write_summary(
            success=verification["success"],
            partial_score=verification["partial_score"],
            total_steps=total_steps,
            total_time_seconds=elapsed,
            cart_state=post["cart"],
            order_confirmed=post["order_confirmed"],
        )

        result = {
            "run_id": logger.run_id,
            "variant": variant,
            "task_id": task_id,
            "phase": phase,
            "repetition_index": rep,
            "success": verification["success"],
            "partial_score": verification["partial_score"],
            "total_steps": total_steps,
            "total_time_seconds": elapsed,
            "order_confirmed": post["order_confirmed"],
            "error_message": None,
            "timestamp_end": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        }

    except Exception as e:
        elapsed = time.monotonic() - t0
        err_msg = str(e)
        print(f"    ERROR: {err_msg}")
        logger.write_summary(
            success=False,
            partial_score=0.0,
            total_steps=logger._step_counter,
            total_time_seconds=elapsed,
            error_message=err_msg,
        )
        result = {
            "run_id": logger.run_id,
            "variant": variant,
            "task_id": task_id,
            "phase": phase,
            "repetition_index": rep,
            "success": False,
            "partial_score": 0.0,
            "total_steps": 0,
            "total_time_seconds": elapsed,
            "error_message": err_msg,
            "timestamp_end": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        }

    finally:
        # Reliable cleanup: close browser session resources
        if browser_session is not None:
            try:
                await browser_session.stop()
            except Exception:
                pass

    status = "✓" if result.get("success") else "✗"
    print(
        f"    {status} score={result.get('partial_score', 0):.2f}"
        f" steps={result.get('total_steps', 0)}"
        f" time={result.get('total_time_seconds', 0):.1f}s"
    )
    return result


# ══════════════════════════════════════════════════════════════════════════════
# EXPERIMENT RUNNER
# ══════════════════════════════════════════════════════════════════════════════

async def run_experiment(
    phase: str = "exp1_observable",
    max_reps: int = 5,
    start_rep: int = 1,
    dry_run: bool = False,
    variant_filter: list = None,
    task_filter: list = None,
    results_dir: Path = None,
):
    tasks = load_tasks()
    task_ids = task_filter or ["T1", "T2", "T3", "T4", "T5"]
    variants = variant_filter or VARIANTS

    target_results_dir = results_dir or DEFAULT_RESULTS_DIR
    target_results_dir.mkdir(parents=True, exist_ok=True)
    logger_module.RESULTS_RAW = target_results_dir / "raw"
    summary_csv = target_results_dir / f"{phase}-summary.csv"
    total = len(variants) * len(task_ids) * max_reps
    done = 0

    print(f"\n{'═' * 60}")
    print("  TechMart Experiment")
    print(f"  Phase: {phase.upper()}")
    print(f"  Model: {AGENT_MODEL}")
    print(f"  Provider: {AGENT_PROVIDER}")
    print(f"  {len(variants)} variants × {len(task_ids)} tasks × {max_reps} reps = {total} runs")
    if dry_run:
        print("  MODE: DRY RUN (no agent execution)")
    print(f"  Results: {summary_csv}")
    print("═" * 60)

    for rep in range(start_rep, start_rep + max_reps):
        print(f"\n── Repetition {rep} of {start_rep + max_reps - 1} ──")
        for variant in variants:
            for task_id in task_ids:
                task = tasks[task_id]
                result = await run_single(
                    variant=variant,
                    task=task,
                    phase=phase,
                    rep=rep,
                    dry_run=dry_run,
                    results_dir=target_results_dir,
                )
                append_to_summary_csv(summary_csv, result)
                done += 1
                print(f"  Progress: {done}/{total} runs")

    print(f"\n{'═' * 60}")
    print(f"  ✓ {phase.upper()} COMPLETE")
    print(f"  Runs completed: {done}")
    print(f"  Summary: {summary_csv}")
    print("═" * 60)


# ══════════════════════════════════════════════════════════════════════════════
# CLI
# ══════════════════════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(
        description="TechMart experiment runner — Protocol v2"
    )
    parser.add_argument(
        "--phase",
        choices=["pilot", "full", "exp1_observable"],
        default="exp1_observable",
        help="Experiment phase (pilot=5 reps, full=10 reps, exp1_observable=instrumented experiment)",
    )
    parser.add_argument(
        "--results-dir",
        type=Path,
        default=DEFAULT_RESULTS_DIR,
        help="Directory to save experimental results (default: C:\\testing\\results\\exp1_observable)",
    )
    parser.add_argument(
        "--start-rep",
        type=int,
        default=1,
        help="Starting repetition index (use 6 when extending pilot to full)",
    )
    parser.add_argument(
        "--reps",
        type=int,
        default=None,
        help="Override number of repetitions per cell (default: 5 for pilot, (10 - start_rep + 1) for full)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Test runner infrastructure without executing agents",
    )
    parser.add_argument(
        "--variants",
        nargs="+",
        choices=VARIANTS,
        help="Run only selected variants (default: all variants)",
    )
    parser.add_argument(
        "--tasks",
        nargs="+",
        choices=["T1", "T2", "T3", "T4", "T5"],
        help="Run only selected tasks (default: all tasks)",
    )
    parser.add_argument(
        "--skip-preflight",
        action="store_true",
        help="Skip static verification checks (not recommended)",
    )

    args = parser.parse_args()

    # Repetition count logic:
    if args.reps is not None:
        if args.reps < 1:
            print("ERROR: --reps must be at least 1.")
            sys.exit(1)
        reps = args.reps
    else:
        reps = 5 if args.phase == "pilot" else (10 - args.start_rep + 1)

    if reps < 1:
        print("ERROR: --start-rep must be between 1 and 10.")
        sys.exit(1)

    print()
    print("TechMart Research Runner")
    print("Protocol v2")
    print()
    print(f"Model:       {AGENT_MODEL}")
    print(f"Provider:    {AGENT_PROVIDER}")
    print(f"Temperature: {AGENT_TEMPERATURE if AGENT_TEMPERATURE is not None else 'default'}")
    print()

    # Preflight check
    if not args.skip_preflight and not args.dry_run:
        print("Running pre-flight verification...")
        errors = check_file_existence()
        if errors:
            print("Pre-flight FAILED:")
            for error in errors:
                print(f"  ✗ {error}")
            sys.exit(1)
        print("✓ Pre-flight passed")

    # API key check
    if not args.dry_run:
        if not os.environ.get("GOOGLE_API_KEY"):
            print()
            print("ERROR: GOOGLE_API_KEY is not set.")
            print()
            print("PowerShell command:")
            print('$env:GOOGLE_API_KEY="YOUR_KEY"')
            print()
            sys.exit(1)
        print("✓ GOOGLE_API_KEY detected")

    asyncio.run(
        run_experiment(
            phase=args.phase,
            max_reps=reps,
            start_rep=args.start_rep,
            dry_run=args.dry_run,
            variant_filter=args.variants,
            task_filter=args.tasks,
            results_dir=args.results_dir,
        )
    )


if __name__ == "__main__":
    main()