try:
    from browser_use.dom.views import DEFAULT_INCLUDE_ATTRIBUTES
except ImportError:
    DEFAULT_INCLUDE_ATTRIBUTES = []

OBSERVABLE_ATTRIBUTES = list(DEFAULT_INCLUDE_ATTRIBUTES) + [
    # Custom data-* attributes used in treatments
    "data-field",
    "data-product-id",
    "data-category-slug",
    "data-page",
    "data-action",
    "data-freshness",
    "data-attrs",
    "data-amount",
    # ARIA attributes
    "aria-atomic",
    "aria-labelledby",
    "aria-live",
    "aria-required",
    "aria-describedby",
    "aria-controls",
    "aria-hidden",
    # Temporal attributes
    "datetime",
]

_DOM_PATCHED = False


def enable_observable_dom_serialization():
    """
    Dynamically patch DOMTreeSerializer in-memory so that:
    1. Elements bearing observable attributes (data-*, aria-*, datetime, role)
       have their visibility recognized even if styled with display:none (.temporal-meta).
    2. _optimize_tree preserves elements bearing observable attributes as meaningful.
    3. serialize_tree retains and formats non-interactive elements bearing observable
       attributes (without assigning interactive click brackets).
    """
    global _DOM_PATCHED
    if _DOM_PATCHED:
        return
    import inspect
    from browser_use.dom.serializer import serializer

    # 1. Patch _create_simplified_tree
    try:
        src1 = inspect.getsource(serializer.DOMTreeSerializer._create_simplified_tree)
        target1 = "has_validation_attrs = any(attr.startswith(('aria-', 'pseudo')) for attr in node.attributes.keys())"
        replacement1 = "has_validation_attrs = any(attr.startswith(('aria-', 'pseudo', 'data-')) or attr in ('datetime', 'role') for attr in node.attributes.keys())"
        if target1 in src1:
            lines1 = src1.splitlines()
            indent1 = len(lines1[0]) - len(lines1[0].lstrip())
            cleaned_src1 = "\n".join(l[indent1:] if len(l) >= indent1 else l for l in lines1)
            patched_src1 = cleaned_src1.replace(target1, replacement1)
            globs1 = serializer.__dict__.copy()
            locs1 = {}
            exec(patched_src1, globs1, locs1)
            serializer.DOMTreeSerializer._create_simplified_tree = locs1["_create_simplified_tree"]
    except Exception:
        pass

    # 2. Patch _optimize_tree
    try:
        src_opt = inspect.getsource(serializer.DOMTreeSerializer._optimize_tree)
        target_opt = "is_visible = node.original_node.snapshot_node and node.original_node.is_visible"
        replacement_opt = (
            "is_visible = (node.original_node.snapshot_node and node.original_node.is_visible) or "
            "bool(node.original_node.attributes and any(attr.startswith(('data-', 'aria-')) or attr in ('datetime', 'role') for attr in node.original_node.attributes.keys()))"
        )
        if target_opt in src_opt:
            lines_opt = src_opt.splitlines()
            indent_opt = len(lines_opt[0]) - len(lines_opt[0].lstrip())
            cleaned_src_opt = "\n".join(l[indent_opt:] if len(l) >= indent_opt else l for l in lines_opt)
            patched_src_opt = cleaned_src_opt.replace(target_opt, replacement_opt)
            globs_opt = serializer.__dict__.copy()
            locs_opt = {}
            exec(patched_src_opt, globs_opt, locs_opt)
            serializer.DOMTreeSerializer._optimize_tree = locs_opt["_optimize_tree"]
    except Exception:
        pass

    # 3. Patch serialize_tree
    try:
        src = inspect.getsource(serializer.DOMTreeSerializer.serialize_tree)
        target_str = "or node.original_node.tag_name.upper() == 'FRAME'"
        replacement_str = (
            "or node.original_node.tag_name.upper() == 'FRAME'\n"
            "\t\t\t\tor bool(node.original_node.attributes and any(k in include_attributes and str(v).strip() != '' for k, v in node.original_node.attributes.items() if (k.startswith('data-') or k.startswith('aria-') or k in ('role', 'datetime'))))"
        )
        if target_str in src:
            lines = src.splitlines()
            indent = len(lines[0]) - len(lines[0].lstrip())
            cleaned_src = "\n".join(l[indent:] if len(l) >= indent else l for l in lines)
            patched_src = cleaned_src.replace(target_str, replacement_str)
            globs = serializer.__dict__.copy()
            locs = {}
            exec(patched_src, globs, locs)
            serializer.DOMTreeSerializer.serialize_tree = staticmethod(locs["serialize_tree"])
    except Exception:
        pass

    _DOM_PATCHED = True


async def extract_active_page_metadata(page) -> str | None:
    """
    Extract ONLY information present in the current live DOM:
    - Active <script type="application/ld+json"> blocks
    - Active evidence/temporal <meta> tags

    Strict constraints:
    - Same extraction code path across all five variants.
    - Zero access to window.__cart__, localStorage, or ground-truth task answers.
    - Dynamic: extracted fresh from the current DOM on each step; cannot persist across SPA navigation.
    """
    if page is None:
        return None
    try:
        # Browser-use Page.evaluate requires arrow function format
        raw = await page.evaluate('''() => {
            const scripts = Array.from(document.querySelectorAll('script[type="application/ld+json"]'))
                .map(s => (s.textContent || '').trim())
                .filter(t => t.length > 0);
            const metas = Array.from(document.querySelectorAll('meta'))
                .map(m => ({
                    name: (m.getAttribute('name') || m.getAttribute('property') || '').trim(),
                    content: (m.getAttribute('content') || '').trim()
                }))
                .filter(m => {
                    const n = m.name.toLowerCase();
                    return (n === 'last-updated' || n === 'data-freshness' || n === 'content-version' || n.startsWith('evidence:'));
                });
            return { jsonld: scripts, meta: metas };
        }''')
    except Exception:
        return None

    if not raw:
        return None

    if isinstance(raw, str):
        try:
            raw = json.loads(raw)
        except Exception:
            return None

    if not isinstance(raw, dict):
        return None

    jsonld_list = raw.get("jsonld", [])
    meta_list = raw.get("meta", [])

    if not jsonld_list and not meta_list:
        return None

    sections = []
    if jsonld_list:
        sections.append("[Page Structured Data (JSON-LD)]")
        for s in jsonld_list:
            try:
                parsed = json.loads(s)
                sections.append(json.dumps(parsed, indent=2))
            except Exception:
                sections.append(s)

    if meta_list:
        sections.append("[Page Metadata]")
        for m in meta_list:
            sections.append(f"{m['name']}: {m['content']}")

    return "\n".join(sections).strip()


